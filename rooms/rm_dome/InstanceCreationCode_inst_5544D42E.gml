label = "Talk to Tavi";
lines = [
    "TAVI: Plenty o' flowers and hardly any fruit! The Tall Harvest feeds all the Tall Ones.",
    "TAVI: A poor harvest means a lot of hungry giants. What's keeping the pollinators away?",
    "FRANCIS: A few thousand more eyes besides mine. Let's investigate.",
    "BEES: Bzzz."
];
repeat_lines = ["TAVI: Have a look around, blueboot. Perhaps you'll spot what I missed."];