label = "Examine: Pollinator Monitor";
note = "monitor";
lines = [
    "Records show native pollinator visits have been falling for weeks.",
    "Most visits used to happen around dusk. Activity dropped shortly after the greenhouse lights stayed on longer.",
    "FRANCIS: Tavi, when did you change the lights?",
    "TAVI: A few weeks ago! We wanted to give the crops more growing time.",
    "NOTEBOOK: POLLINATOR MONITOR recorded."
